dutykit.dev {
	encode gzip
	# MCP-Endpunkt und Statusprüfung an den Python-Dienst
	handle /mcp* {
		reverse_proxy dutykit:8080
	}
	handle /health {
		reverse_proxy dutykit:8080
	}
	# Doku-Seite, llms.txt, Impressum
	handle {
		root * /srv/site
		file_server
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.shields.io; script-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	# Kein Zugriffslog mit IP-Adressen (Datenschutz); Fehlerlog genügt
}

www.dutykit.dev {
	redir https://dutykit.dev{uri} permanent
}
