# Kopie als .env auf dem Server ablegen (/opt/dutykit/deploy/.env)
DUTYKIT_HOSTS=dutykit.dev
DUTYKIT_FREI_PRO_TAG=200
# Serverseitiges Protokoll: 0 in der Freistufe (keine Speicherung von Eingaben)
DUTYKIT_PROTOKOLL=0

# ===== SCHALTER BEZAHLSTUFE =====
# Erst nach Niederlassungsgenehmigung + Stripe-Konto der Firma auf 1 setzen,
# dann:  cd /opt/dutykit/deploy && docker compose up -d
DUTYKIT_BILLING=0
STRIPE_SECRET_KEY=
DUTYKIT_STRIPE_METER=dutykit_calls
